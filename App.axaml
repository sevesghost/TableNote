<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TableNote.App"
             RequestedThemeVariant="Light">
  <!-- One font for every control: Noto Sans Thai with the Latin of Noto Sans and a few Noto symbols merged in
       (Assets/Fonts, tools/fonts/merge_noto.py), so Thai text, digits and Latin never mix two designs. -->
  <Application.Resources>
    <FontFamily x:Key="ContentControlThemeFontFamily">avares://TableNote/Assets/Fonts#Noto Sans Thai</FontFamily>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://TableNote/Assets/Fonts#Noto Sans Thai" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="avares://TableNote/Assets/Fonts#Noto Sans Thai" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="avares://TableNote/Assets/Fonts#Noto Sans Thai" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="avares://TableNote/Assets/Fonts#Noto Sans Thai" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontFamily" Value="avares://TableNote/Assets/Fonts#Noto Sans Thai" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontFamily" Value="avares://TableNote/Assets/Fonts#Noto Sans Thai" />
    </Style>
  </Application.Styles>
</Application>
