<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Linux/dev build: net10.0. Windows publish (-r win-x64): Windows TFM so the toast API (WinRT) is available. -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(TableNoteWindows)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>TableNote</RootNamespace>
    <AssemblyName>TableNote</AssemblyName>
    <Version>2.4.2</Version>
    <AssemblyVersion>2.4.2.0</AssemblyVersion>
    <FileVersion>2.4.2.0</FileVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en;th</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- P9: the Windows publish is win-x64 only, single file, no other platforms' native files. Not trimmed
       (Avalonia + the toast toolkit use reflection; trimming is not proven safe — see release notes). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.3" Condition="'$(RuntimeIdentifier)' != 'win-x64'" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" Condition="'$(RuntimeIdentifier)' != 'win-x64'" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <!-- v2.4.2: UI texts, one file per language. Add lang/xx.json to add a language (see CONTRIBUTING). -->
  <ItemGroup>
    <EmbeddedResource Include="lang\*.json" LogicalName="TableNote.lang.%(Filename).json" />
    <None Remove="lang\*.json" />
  </ItemGroup>
  <!-- v2.4.1: test projects live under tests/ and must not be compiled into the app. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <AvaloniaResource Remove="tests/**" />
  </ItemGroup>
  <!-- Size: SkiaSharp/HarfBuzz native packages ship ~100 MB of native .pdb files that land next to the exe in the
       publish folder (not inside the bundle). They are debug-only; keep them out of the portable publish output. -->
  <Target Name="TableNoteDropNativePdbs" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
