<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- One target framework on every OS. Up to 2.5.0 the Windows publish used net10.0-windows10.0.19041.0 for a silent
         WinRT toast, which put the 24 MB Windows SDK projection into the exe; the toast is gone (the reminder window and
         its sound are unchanged). -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- The Windows exe is trimmed (below) and a trimmed app can't use reflection-based JsonSerializer, so note.json and
         undo snapshots use source-generated metadata (Core/TableNoteJson.cs). Reflection is off in EVERY build, not only
         the trimmed one, so a missed call fails on Linux and in tests too; the analyzer flags trimming problems on build. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 2.6.0: the Table Note logo (gold grid and page on a white tile), also the window and tray icon. -->
    <ApplicationIcon>Assets\Brand\TableNote.ico</ApplicationIcon>
    <RootNamespace>TableNote</RootNamespace>
    <AssemblyName>TableNote</AssemblyName>
    <Version>2.6.1</Version>
    <AssemblyVersion>2.6.1.0</AssemblyVersion>
    <FileVersion>2.6.1.0</FileVersion>
    <InformationalVersion>2.6.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en;th</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- P9: the Windows publish is win-x64 only, single file, no other platforms' native files.
       Trimmed, partial mode: unused code of .NET and Avalonia is removed, TableNote.dll itself is kept whole.
       2.6.1, start-up and memory (measured: docs/performance.md):
       - ReadyToRun: the code is compiled ahead of time into the exe (one composite image for .NET, Avalonia and
         TableNote). Trimming had removed the precompiled code that .NET ships, so every start compiled all of it again;
         the table now opens about 3-4 times sooner.
       - No compression inside the exe: the code is used straight from the file instead of being unpacked into memory
         at every start (less memory in use; the zip download is about the same size either way).
       - Tiered compilation off: the precompiled code is used as it is, instead of being compiled a second time in the
         background during the first half minute (far less CPU after a start; also a little less memory). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <TieredCompilation>false</TieredCompilation>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.3" Condition="'$(RuntimeIdentifier)' != 'win-x64'" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" Condition="'$(RuntimeIdentifier)' != 'win-x64'" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <!-- v2.4.2: UI texts, one file per language. Add lang/xx.json to add a language (see CONTRIBUTING). -->
  <ItemGroup>
    <EmbeddedResource Include="lang\*.json" LogicalName="TableNote.lang.%(Filename).json" />
    <None Remove="lang\*.json" />
  </ItemGroup>
  <!-- v2.4.1: test projects live under tests/ and must not be compiled into the app. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <AvaloniaResource Remove="tests/**" />
  </ItemGroup>
  <!-- Size: SkiaSharp/HarfBuzz native packages ship ~100 MB of native .pdb files that land next to the exe in the
       publish folder (not inside the bundle). They are debug-only; keep them out of the portable publish output. -->
  <Target Name="TableNoteDropNativePdbs" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
