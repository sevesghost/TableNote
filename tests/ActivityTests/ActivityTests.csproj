<Project Sdk="Microsoft.NET.Sdk">
  <!-- 2.6.0 activity bar: the activity log (running / done / merged / thread-safe), the watchdog note, settings, and the bar in the real window. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../TableNote.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.5" />
  </ItemGroup>
</Project>
