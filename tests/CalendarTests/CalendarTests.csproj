<Project Sdk="Microsoft.NET.Sdk">
  <!-- 2.7.0: the calendar (month grid, rows by day, adding / moving rows, settings), the calendar window and its day
       pop-up table driven headless against the real editor, and the calendar on the wallpaper (bottom right). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../TableNote.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.5" />
  </ItemGroup>
</Project>
